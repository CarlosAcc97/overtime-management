{
  "name": "overtime-backend",
  "version": "1.0.0",
  "description": "Backend API - Sistema de Horas Extras Gerencia de Distribución",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env src/db/seed.js",
    "db:seed:overtime": "node --env-file=.env src/db/seed.overtime.js",
    "db:seed:all": "node --env-file=.env src/db/seed.js && node --env-file=.env src/db/seed.overtime.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.4",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.22.8"
  }
}
