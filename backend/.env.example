NODE_ENV=production
PORT=3001

# ── Base de datos ─────────────────────────────────────────────────────────────
# LOCAL (desarrollo):
#   DATABASE_URL=./data/overtime.db
# TURSO (producción):
#   DATABASE_URL=libsql://nombre-de-tu-db.turso.io
#   TURSO_AUTH_TOKEN=ey...
DATABASE_URL=libsql://nombre-de-tu-db.turso.io
TURSO_AUTH_TOKEN=ey_tu_token_aqui

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_seguro_de_64_chars
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_seguro_de_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL de tu frontend en Vercel (puede ser varias separadas por coma)
CORS_ORIGIN=https://tu-app.vercel.app
